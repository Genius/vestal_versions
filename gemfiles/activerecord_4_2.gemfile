source 'https://rubygems.org'

source 'https://gems.railslts.com' do
  gem 'activemodel', '~> 4.2.11'
  gem 'activerecord', '~> 4.2.11'
  gem 'activesupport', '~> 4.2.11'
end

gem 'ruby3-backward-compatibility', '~> 1.5'

gemspec :path => '..'

group :test do
  gem 'pg', '~> 1.5'
  gem 'rspec', '~> 3.9'
  gem 'rspec-its', '~> 1.0'
end
